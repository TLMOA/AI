{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "File Meta Schema",
  "type": "object",
  "properties": {
    "fileId": { "type": "string" },
    "fileName": { "type": "string" },
    "sourceType": { "type": "string", "enum": ["db_export", "upload", "manual_tag", "auto_tag"] },
    "storageType": { "type": "string", "enum": ["plain", "tagged"] },
    "storagePath": { "type": "string" },
    "hasTag": { "type": "boolean" },
    "tagColumn": { "type": ["string", "null"] },
    "tagName": { "type": ["string", "null"] },
    "tagRange": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "tagStrategy": { "type": "string", "enum": ["column_tag", "manual_range", "auto_rule", "none"] },
    "tagRule": {
      "type": ["object", "null"],
      "properties": {
        "ruleName": { "type": "string" },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "mapping": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "when": { "type": "object" },
              "tag": { "type": "string" }
            },
            "required": ["when", "tag"]
          }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["fileId", "fileName", "sourceType", "storageType", "storagePath", "hasTag", "createdAt", "updatedAt"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "hasTag": { "const": true } } },
      "then": { "required": ["tagColumn", "tagName"] }
    },
    {
      "if": { "properties": { "hasTag": { "const": false } } },
      "then": { "required": ["tagRange"] }
    }
  ]
}
