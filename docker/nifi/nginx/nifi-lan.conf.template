# NiFi LAN reverse proxy (HTTPS termination at nginx)
# Replace HOST_IP before enabling.

server {
    listen 80;
    listen [::]:80;
    server_name HOST_IP;
    return 301 https://$host$request_uri;
}

server {
    listen 9443 ssl;
    listen [::]:9443 ssl;
    server_name HOST_IP;

    ssl_certificate     /etc/nginx/ssl/nifi-lan.crt;
    ssl_certificate_key /etc/nginx/ssl/nifi-lan.key;

    # Keep conservative defaults for internal LAN deployment.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    location / {
        proxy_pass https://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Upstream NiFi cert might not chain to system CA; keep off for bootstrap.
        proxy_ssl_server_name on;
        proxy_ssl_verify off;

        # Avoid read timeout on large flow operations.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
