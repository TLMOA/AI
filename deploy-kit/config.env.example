# ============================================================
# IoT 智慧平台 部署参数（复制为 config.env 后修改）
#   cp config.env.example config.env
# 密码/密钥留空 = 部署时自动生成（生成结果写入 .deploy-secrets）
# ============================================================

# ---------- 机器与路径 ----------
# 建议保持 yhz + /home/yhz/iot，因为历史配置里路径是硬编码的，
# 用默认组合可以零改动复用全部模板。
APP_USER=yhz
APP_HOME=/home/yhz
CODE_DIR=/home/yhz/iot

# ---------- 代码来源 ----------
# 留空则跳过拉取（适用于已把代码放到位的场景，如 rsync/离线包）
GIT_REPO=
GIT_BRANCH=main

# ---------- 端口 ----------
FRONTEND_PORT=5174
BACKEND_PORT=8081
NIFI_PORT=8080
# 绑定地址：
#   前端 = 0.0.0.0，用户才能用浏览器直连 http://<服务器IP>:5174
#          （若绑 127.0.0.1，就只能靠 Nginx 的 80 端口访问；而很多内网会挡 80）
#   后端 = 127.0.0.1，只经 serve.py 的 /api/v1 代理对外，不直接暴露
FRONTEND_BIND=0.0.0.0
BACKEND_BIND=127.0.0.1

# ---------- 数据库 ----------
DB_NAME=nifi
DB_USER=iot
DB_PASS=
MYSQL_ROOT_PASS=

# ---------- 本站唯一账号 ----------
# 每套实例只建这一个账号（不填 SITE_USER 时兼容旧 ADMIN_USER）
#   忽米机器：  SITE_USER=humi       SITE_IS_ADMIN=true
#   工厂机器：  SITE_USER=factory_a  SITE_IS_ADMIN=true（可进内部管理页，推荐）
#                                    SITE_IS_ADMIN=false（纯普通用户，忽米无法远程查看）
SITE_USER=humi
SITE_IS_ADMIN=true
SITE_PASS=

# 旧参数（保持兼容，不再单独使用）
ADMIN_USER=humi
ADMIN_PASS=

# ---------- 会话与安全 ----------
SESSION_TTL=86400

# ---------- 对外访问 ----------
DOMAIN=iot.example.com
NIFI_PROXY_HOST=127.0.0.1:8080,localhost:8080
# 是否写 Nginx 配置（false = 只生成模板不安装）
INSTALL_NGINX=true

# ---------- 方案一：关闭自助注册（忽米统一开户）----------
# 三者一起构成完整闭环，默认全开：
#   1) 后端补丁：让 IOT_ALLOW_SELF_REGISTER 环境变量真正生效（不打补丁则配了也没用）
#   2) 前端下线：register.html 重命名 + login.html 注册按钮注释
#   3) 环境变量：override.conf 写入 IOT_ALLOW_SELF_REGISTER=false
# 去掉后端 init_db() 自动创建的默认 admin（否则实例会多出一个账号，且历史默认口令是 123456）
APPLY_NO_DEFAULT_ADMIN_PATCH=true
APPLY_SELF_REGISTER_PATCH=true
DISABLE_REGISTER_PAGE=true
ALLOW_SELF_REGISTER=false

# ---------- 可选增强 ----------
# 新机器上自动 apt 安装 python3/nginx/mysql/docker（已装好的机器保持 false，避免影响现有环境）
INSTALL_SYSTEM_DEPS=false
# 安装 SQL Server ODBC 驱动（离线 deb，仅「连 SQL Server 导数据」才需要；装了不碍事）
INSTALL_ODBC=true
# 打上「私有化用户数据写本地盘」补丁（改 main.py 的 _resolve_user_storage_root）
APPLY_PRIVATE_STORAGE_PATCH=false
# 私有化用户的默认数据根（留空则用 APP_HOME）
PRIVATE_DATA_ROOT=
# 是否构建并启动 NiFi 容器（无 docker 环境可关）
INSTALL_NIFI=true
