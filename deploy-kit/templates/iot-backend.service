[Unit]
Description=IoT V1 Backend (FastAPI)
After=network-online.target remote-fs.target
Wants=network-online.target remote-fs.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__CODE_DIR__/v1-backend
ExecStart=__CODE_DIR__/v1-backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port __BACKEND_PORT__
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sleep 2

[Install]
WantedBy=multi-user.target
